@page "/asignaturas/crear"
@inject Tarea2.Application.Services.AsignaturaService Service
@inject NavigationManager Nav

<div class="card" style="max-width:700px;">
    <div class="card-header text-center">
        <h3 class="mb-0">Crear Asignatura</h3>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label fw-semibold">Código</label>
                <InputText class="form-control" @bind-Value="model.Codigo" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre</label>
                <InputText class="form-control" @bind-Value="model.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Aula</label>
                <InputText class="form-control" @bind-Value="model.Aula" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Créditos</label>
                <InputNumber class="form-control" @bind-Value="model.Creditos" />
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary" @onclick="Volver">← Volver</button>
                <button type="submit" class="btn btn-primary">💾 Guardar</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Tarea2.Domain.Entities.Asignatura model = new();
    private string? error;

    private void Volver() => Nav.NavigateTo("/asignaturas");

    private async Task Guardar()
    {
        error = null;
        try
        {
            await Service.CrearAsync(model);
            Nav.NavigateTo("/asignaturas");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}


