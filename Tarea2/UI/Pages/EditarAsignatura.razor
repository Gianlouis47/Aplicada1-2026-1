@page "/asignaturas/editar/{Id:int}"
@inject Tarea2.Application.Services.AsignaturaService Service
@inject NavigationManager Nav

<div class="card" style="max-width:700px;">
    <div class="card-header text-center">
        <h3 class="mb-0">Modificar Asignatura</h3>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (model is null)
        {
            <div>Cargando...</div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="Modificar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Código</label>
                    <InputText class="form-control" @bind-Value="model.Codigo" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nombre</label>
                    <InputText class="form-control" @bind-Value="model.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Aula</label>
                    <InputText class="form-control" @bind-Value="model.Aula" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Créditos</label>
                    <InputNumber class="form-control" @bind-Value="model.Creditos" />
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" @onclick="Volver">← Volver</button>
                    <button type="submit" class="btn btn-primary">💾 Modificar</button>
                    <button type="button" class="btn btn-danger" @onclick="Eliminar">🗑 Eliminar</button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Tarea2.Domain.Entities.Asignatura? model;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        model = await Service.ObtenerPorIdAsync(Id);
        if (model is null) Nav.NavigateTo("/asignaturas");
    }

    private void Volver() => Nav.NavigateTo("/asignaturas");

    private async Task Modificar()
    {
        error = null;
        if (model is null) return;

        try
        {
            await Service.ActualizarAsync(model);
            Nav.NavigateTo("/asignaturas");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Eliminar()
    {
        if (model is null) return;
        await Service.EliminarAsync(model.AsignaturaId);
        Nav.NavigateTo("/asignaturas");
    }
}
