@page "/tipospuntos/editar/{Id:int}"
@inject TiposPuntosService Service
@inject NavigationManager Nav

<div class="card shadow-sm" style="max-width: 780px; margin: 0 auto;">
    <div class="card-header text-center">
        <h3 class="mb-0">Modificar Tipo de Puntos</h3>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (model is null)
        {
            <div class="text-center">Cargando...</div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="Modificar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nombre</label>
                    <InputText class="form-control" @bind-Value="model.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descripción</label>
                    <InputText class="form-control" @bind-Value="model.Descripcion" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Valor Puntos</label>
                    <InputNumber class="form-control" @bind-Value="model.ValorPuntos" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Color</label>
                    <InputText class="form-control" @bind-Value="model.Color" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Icono</label>
                    <InputText class="form-control" @bind-Value="model.Icono" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Activo</label>
                    <InputSelect class="form-select" @bind-Value="model.Activo">
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                    </InputSelect>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" @onclick="Volver">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </button>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i> Modificar
                    </button>

                    <button type="button" class="btn btn-danger" @onclick="Eliminar">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Tarea3.Models.TiposPuntos? model;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        model = await Service.Buscar(Id);
        if (model is null) Nav.NavigateTo("/tipospuntos");
    }

    private void Volver() => Nav.NavigateTo("/tipospuntos");

    private async Task Modificar()
    {
        error = null;
        if (model is null) return;

        try
        {
            await Service.Guardar(model);
            Nav.NavigateTo("/tipospuntos");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task Eliminar()
    {
        if (model is null) return;

        await Service.Eliminar(model.TipoId);
        Nav.NavigateTo("/tipospuntos");
    }
}
