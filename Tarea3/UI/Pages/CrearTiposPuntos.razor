@page "/tipospuntos/crear"
@inject TiposPuntosService Service
@inject NavigationManager Nav

<div class="card shadow-sm" style="max-width: 780px; margin: 0 auto;">
    <div class="card-header text-center">
        <h3 class="mb-0">Crear Tipo de Puntos</h3>
    </div>

    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre</label>
                <InputText class="form-control" @bind-Value="model.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Descripción</label>
                <InputText class="form-control" @bind-Value="model.Descripcion" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Valor Puntos</label>
                <InputNumber class="form-control" @bind-Value="model.ValorPuntos" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Color</label>
                <InputText class="form-control" @bind-Value="model.Color" placeholder="#RRGGBB o nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Icono</label>
                <InputText class="form-control" @bind-Value="model.Icono" placeholder="ej: bi-star" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Activo</label>
                <InputSelect class="form-select" @bind-Value="model.Activo">
                    <option value="true">Sí</option>
                    <option value="false">No</option>
                </InputSelect>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary" @onclick="Volver">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </button>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i> Guardar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Tarea3.Models.TiposPuntos model = new() { Activo = true, ValorPuntos = 1 };

    private string? error;

    private void Volver() => Nav.NavigateTo("/tipospuntos");

    private async Task Guardar()
    {
        error = null;

        try
        {
            await Service.Guardar(model);
            Nav.NavigateTo("/tipospuntos");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
